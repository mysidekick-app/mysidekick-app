{
  "expo": {
    "name": "My Sidekick",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sidekick-icon-square.png",
    "scheme": "mysidekick",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#000000",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mysidekickapp",
      "backgroundColor": "#000000",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
  "package": "com.mysidekick.boltexponativewind",
  "softwareKeyboardLayoutMode": "resize",
  "backgroundColor": "#000000",
  "googleServicesFile": "./google-services.json"
    },

    

    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "enforceContrast": false
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/sidekick-favicon.png"
    },

    "plugins": [
  "expo-router",
  "expo-font",
  "expo-web-browser",
  "expo-system-ui",
  [
    "expo-notifications",
    {
      "icon": "./assets/notification-icon.png",
      "color": "#FFFFFF"
    }
  ],
  [
    "expo-splash-screen",
    {
      "image": "./assets/sidekick-logo.png",
      "imageWidth": 200
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd77b2fa-e4f7-4cf3-b85f-93d8363f9296"
      }
    }
  }
}