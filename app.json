{
  "expo": {
    "name": "My Sidekick",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sidekick.png",
    "scheme": "mysidekick",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mysidekick.app"
    },

    "android": {
      "package": "com.mysidekick.boltexponativewind"
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/sidekick-favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd77b2fa-e4f7-4cf3-b85f-93d8363f9296"
      }
    }
  }
}